{
  "name": "ilm",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db": "node tooling/scripts/local-db.mjs start",
    "db:stop": "node tooling/scripts/local-db.mjs stop",
    "db:reset": "node tooling/scripts/local-db.mjs reset",
    "db:migrate": "pnpm --filter @ilm/db migrate",
    "db:seed": "pnpm --filter @ilm/db seed",
    "verify:rls-role": "node tooling/scripts/verify-rls-role.mjs",
    "verify:isolation": "node tooling/scripts/verify-isolation.mjs",
    "verify:browser": "node tooling/scripts/verify-browser.mjs",
    "verify:platform": "node tooling/scripts/verify-platform.mjs"
  },
  "devDependencies": {
    "@ilm/config": "workspace:*",
    "dotenv": "^17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.1"
    }
  }
}

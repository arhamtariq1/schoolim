// Schema v0 — Phase 0 foundation: tenancy, identity, audit. No features.
//
// Rules that apply to every model below, so they are not repeated (CLAUDE.md):
//   1. Every tenant-scoped table carries `school_id uuid NOT NULL`.
//   2. Every tenant-scoped table has RLS enabled AND forced, with the
//      `tenant_isolation` policy. Applied in the migration, checked by
//      `tooling/scripts/check-rls.mjs` in CI.
//   3. Every index on a tenant table leads with `school_id`.
//   4. Every tenant model is registered in TENANT_MODELS.
//
// Money is `numeric(14,2)` here and integer paisa in code (ADR-0007). No money
// appears in this migration; the rule is stated so it is not re-litigated.

generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  // Prisma 7 generates ESM by default and its client uses import.meta.url,
  // which forces Node to parse the file as ESM. apps/api is CommonJS because
  // NestJS needs legacy decorators and emitDecoratorMetadata (docs/05), so the
  // generated client must be CommonJS too.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform — outside tenancy. No `school_id`, no tenant RLS policy.
// Reachable only by the platform role; the application role has no grant.
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING

  @@map("platform_role")
}

/// Platform staff. A separate table from `users` with its own login route and
/// cookie, so a tenant JWT can never satisfy a platform guard (docs/04 s6).
model PlatformUser {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  /// TOTP secret. 2FA is mandatory here: this account reaches every school.
  mfaSecret    String?      @map("mfa_secret")
  mfaEnabledAt DateTime?    @map("mfa_enabled_at") @db.Timestamptz(6)
  role         PlatformRole
  /// Bumped to invalidate every issued token for this account at once.
  tokenVersion Int          @default(0) @map("token_version")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions PlatformSession[]

  @@map("platform_users")
}

/// Platform staff sessions. A separate table from `sessions`, not a nullable
/// `school_id` on that one: `sessions.school_id` is NOT NULL and carries the
/// tenant_isolation policy, and relaxing it to fit three staff accounts would
/// put a hole in the mechanism that isolates every school.
///
/// Deliberately outside TENANT_MODELS: it has no `school_id` because it belongs
/// to no school. See TENANT_RLS_EXEMPT_TABLES.
model PlatformSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  platformUserId   String    @map("platform_user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  /// Hashed, never stored in the clear — same reasoning as `sessions`.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

/// In-progress self-serve signup: credentials → email OTP → school details.
///
/// Lives outside tenancy because the school does not exist yet. The opaque
/// `session_token_hash` is what the `ilm_su` cookie proves; the password is
/// hashed here and only materialised into `users` on complete. Retention: rows
/// expire within a day and are deleted by a sweeper; completing clears the row
/// after the school exists. The application role holds no grant.
model SignupIntent {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  name             String
  passwordHash     String    @map("password_hash")
  termsVersion     String    @map("terms_version")
  /// SHA-256 of the 6-digit OTP. Cleared once verified.
  otpHash          String?   @map("otp_hash")
  otpExpiresAt     DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpSentAt        DateTime? @map("otp_sent_at") @db.Timestamptz(6)
  otpAttempts      Int       @default(0) @map("otp_attempts")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Opaque cookie value, hashed like a refresh token.
  sessionTokenHash String    @unique @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([expiresAt])
  @@map("signup_intents")
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  /// Read-only. Dunning never deletes a school's data (docs/19 s4).
  SUSPENDED
  CHURNED

  @@map("school_status")
}

enum BillingMode {
  PER_CAMPUS
  CONSOLIDATED

  @@map("billing_mode")
}

/// Reserved by the first migration, unused until Phase 9. See ADR-0008.
/// Present now because adding a parent above `schools` later is a far more
/// disruptive migration than carrying a nullable foreign key from the start.
model SchoolGroup {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String       @unique
  legalName   String?      @map("legal_name")
  logoUrl     String?      @map("logo_url")
  billingMode BillingMode  @default(PER_CAMPUS) @map("billing_mode")
  status      SchoolStatus @default(TRIAL)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schools School[]

  @@map("school_groups")
}

/// One row is one campus. A standalone school has `schoolGroupId` null.
/// This is the tenant root: `school_id` on every other table points here.
model School {
  id                     String       @id @default(uuid(7)) @db.Uuid
  schoolGroupId          String?      @map("school_group_id") @db.Uuid
  name                   String
  /// Resolves the tenant from the subdomain. Never a school picker at login,
  /// which would leak the tenant list (docs/09 s2).
  slug                   String       @unique
  legalName              String?      @map("legal_name")
  logoUrl                String?      @map("logo_url")
  primaryColor           String?      @map("primary_color")
  timezone               String       @default("Asia/Karachi")
  locale                 String       @default("en")
  currency               String       @default("PKR")
  country                String       @default("PK")
  city                   String?
  address                String?
  phone                  String?
  email                  String?
  status                 SchoolStatus @default(TRIAL)
  /// The surcharge once a voucher's due date passes, as configuration rather
  /// than a rate in the code. Both default to zero, so the "after due date" box
  /// prints the same figure until a school sets its own rule.
  lateFeePercent         Decimal      @default(0) @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeFlat            Decimal      @default(0) @map("late_fee_flat") @db.Decimal(14, 2)
  /// ISO day numbers the school runs — 1 is Monday, 7 is Sunday. The
  /// denominator of every attendance percentage, together with `holidays`.
  /// Defaults to Monday–Saturday, which is what most schools here keep.
  workingDays            Int[]        @default([1, 2, 3, 4, 5, 6]) @map("working_days") @db.SmallInt
  /// How far back a mark may be recorded without `attendance.record.unlock`.
  attendanceBackdateDays Int          @default(7) @map("attendance_backdate_days") @db.SmallInt
  onboardedAt            DateTime?    @map("onboarded_at") @db.Timestamptz(6)
  trialEndsAt            DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolGroup           SchoolGroup?            @relation(fields: [schoolGroupId], references: [id], onDelete: Restrict)
  domains               SchoolDomain[]
  users                 User[]
  userRoles             UserRole[]
  sessions              Session[]
  invitations           Invitation[]
  passwordResets        PasswordReset[]
  authHandoffs          AuthHandoff[]
  emailVerifications    EmailVerification[]
  agreements            SchoolAgreement[]
  academicSessions      AcademicSession[]
  classLevels           ClassLevel[]
  schoolSections        Section[]
  students              Student[]
  guardians             Guardian[]
  studentGuardians      StudentGuardian[]
  enrollments           Enrollment[]
  feeHeads              FeeHead[]
  holidays              Holiday[]
  staff                 Staff[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  jobRuns               JobRun[]
  feeVouchers           FeeVoucher[]
  feeVoucherLines       FeeVoucherLine[]
  feeVoucherPeriods     FeeVoucherPeriod[]
  feeVoucherArrears     FeeVoucherArrear[]
  feePayments           FeePayment[]
  feePaymentAllocations FeePaymentAllocation[]
  attendanceRecords     AttendanceRecord[]
  staffAttendance       StaffAttendanceRecord[]
  studentFees           StudentFee[]
  numberSequences       NumberSequence[]
  securityDeposits       SecurityDeposit[]
  securityDepositRefunds SecurityDepositRefund[]
  logo                   SchoolLogo?

  @@index([schoolGroupId])
  @@index([status])
  @@map("schools")
}

/// Custom domains, in addition to the `{slug}` subdomain. The TenantGuard
/// matches the request host against these, and a host that disagrees with the
/// JWT tenant claim is a 401 (docs/04 s2).
model SchoolDomain {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  domain     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_domains")
}

// ---------------------------------------------------------------------------
// Identity — tenant-scoped. RLS enabled and forced on every table below.
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// Mirrors SCHOOL_ROLES in @ilm/contracts. A test asserts the two lists are
/// identical, so drift between the database and the permission matrix is a
/// failing build rather than a production surprise.
enum SchoolRole {
  OWNER
  PRINCIPAL
  ADMIN
  ACCOUNTANT
  RECEPTION
  TEACHER
  COORDINATOR
  STUDENT
  PARENT

  @@map("school_role")
}

/// A person at one school. Someone who is both a parent and a teacher at the
/// same school is ONE user with two `user_roles` rows. Someone at two schools
/// is two users — that is what keeps `school_id` on this table and makes tenant
/// isolation total (docs/07 s2).
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @map("school_id") @db.Uuid
  /// Reserved for Phase 9: one login across the campuses of a school group.
  /// Unused until then. ADR-0008.
  identityId         String?    @map("identity_id") @db.Uuid
  email              String
  phone              String?
  name               String
  passwordHash       String?    @map("password_hash")
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(INVITED)
  /// Null until the person has proved they can read mail at `email`.
  ///
  /// Deliberately a timestamp and not a boolean: "when did they confirm" is the
  /// question asked in a dispute, and a boolean cannot answer it. Cleared when
  /// the address changes, because the proof was about the old one (ADR-0012).
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  tokenVersion       Int        @default(0) @map("token_version")
  locale             String?
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Consecutive failures, for lockout. Reset on a successful login.
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles              UserRole[]
  sessions           Session[]
  passwordResets     PasswordReset[]
  authHandoffs       AuthHandoff[]
  emailVerifications EmailVerification[]
  invitesSent        Invitation[]        @relation("InvitedBy")
  staffRecord        Staff?

  /// Email is unique per school, not globally: the same person may hold an
  /// account at two schools with the same address. That is precisely why
  /// sign-in at the apex can return several schools — see ADR-0009.
  @@unique([schoolId, email])
  @@index([schoolId, status])
  @@index([schoolId, email])
  @@index([schoolId, phone])
  /// The only deliberately un-scoped indexes in the product. Global sign-in
  /// looks an identifier up across every school before a tenant exists, which
  /// is the one query in the system that is *supposed* to cross tenants — and
  /// it runs on the admin connection, on an unauthenticated endpoint, so it
  /// must not be a sequential scan over every user row on the platform.
  @@index([email])
  @@index([phone])
  @@map("users")
}

/// Roles are additive. `scope` carries the data a scoped grant is limited to,
/// for example `{ "sectionIds": [...] }` for a teacher — scope is data compiled
/// into a query clause, never a code branch (docs/08 s5).
model UserRole {
  id        String     @id @default(uuid(7)) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      SchoolRole
  scope     Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, role])
  @@index([schoolId, userId])
  @@map("user_roles")
}

/// One refresh-token family per login. Rotation replaces the row's hash;
/// replaying a consumed token revokes the entire family (docs/11 s8).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Shared by every token issued from one login, so reuse detection can
  /// revoke the whole chain rather than a single token.
  familyId         String    @map("family_id") @db.Uuid
  /// The token itself is never stored — only a hash, like a password.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, familyId])
  @@index([schoolId, expiresAt])
  @@map("sessions")
}

model Invitation {
  id         String     @id @default(uuid(7)) @db.Uuid
  schoolId   String     @map("school_id") @db.Uuid
  email      String
  role       SchoolRole
  tokenHash  String     @unique @map("token_hash")
  invitedBy  String?    @map("invited_by") @db.Uuid
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inviter User?  @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
  @@index([schoolId, expiresAt])
  @@map("invitations")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("password_resets")
}

/// A verified password on one hostname, redeemed for a session on another.
///
/// Signing in at the apex proves who you are but cannot give you a cookie: the
/// session cookie is host-only by design (docs/04, `COOKIE_DOMAIN` unset), so
/// only `{slug}.<domain>` can set the session for that school. This row is the
/// bridge — minted after the password checks out, redeemed once, seconds later,
/// on the school's own address. See ADR-0009.
///
/// It is a table and not a self-contained signed token for one reason:
/// **single use has to be enforced somewhere.** `UPDATE ... WHERE consumed_at
/// IS NULL RETURNING` is atomic; a stateless token replayed twice inside its
/// window is two sessions, and the URL travels through browser history.
model AuthHandoff {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the token. The token itself exists only in the redirect URL —
  /// a leaked database backup must not hand out live sessions.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, expiresAt])
  @@map("auth_handoffs")
}

/// Proof that somebody can read mail at the address they typed. ADR-0012.
///
/// Same shape as `password_resets` and for the same reasons: hashed token,
/// short expiry, single use. The one addition is `email` — the address the
/// token was *sent to*, copied rather than joined. Someone can change their
/// address between a link being sent and clicked, and a token that verified
/// whatever the user row happens to say at redemption time would verify an
/// address nobody ever proved.
model EmailVerification {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// The address this token was sent to. The check is against this, not `user.email`.
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  /// When the message actually went out, for rate limiting resends.
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, expiresAt])
  @@map("email_verifications")
}

enum AgreementDocument {
  TERMS_OF_SERVICE
  /// Data processing agreement. Separate row, separate version line.
  DPA

  @@map("agreement_document")
}

/// Who accepted which version of what, and when — docs/17 s3, docs/19 s6.
///
/// Sales-led onboarding had a person who could attest to this afterwards.
/// Self-serve does not (ADR-0010): if the tick box is not recorded at the
/// moment it is ticked, the answer to "did this school accept the DPA?" is
/// permanently unknowable. That is why this ships with signup rather than with
/// the rest of billing in Phase 5.
///
/// The accepter's name and email are **copied, not joined**. The user row can
/// be renamed, reassigned or erased under the retention policy; the acceptance
/// has to survive all three and still say who signed.
///
/// Retention (CLAUDE.md): erased with the school, 7 years after the contract
/// ends — it is the evidence for the contract, so it outlives the tenant's
/// operational data rather than being anonymised with it.
model SchoolAgreement {
  id               String            @id @default(uuid(7)) @db.Uuid
  schoolId         String            @map("school_id") @db.Uuid
  documentType     AgreementDocument @map("document_type")
  version          String
  acceptedAt       DateTime          @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?           @map("accepted_by_user_id") @db.Uuid
  acceptedByName   String            @map("accepted_by_name")
  acceptedByEmail  String            @map("accepted_by_email")
  ip               String?
  userAgent        String?           @map("user_agent")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, documentType, version])
  @@index([schoolId, acceptedAt])
  @@map("school_agreements")
}

enum ActorType {
  USER
  /// A platform user acting through impersonation. The audit row records both
  /// the impersonated user and the platform actor (docs/17 s5).
  PLATFORM
  SYSTEM

  @@map("actor_type")
}

/// Append-only. The application role holds no UPDATE or DELETE grant on this
/// table (docs/12 R8), which is what makes an impersonation record impossible
/// to quietly remove.
///
/// Partitioned by month on `at`. PostgreSQL requires the partition key in the
/// primary key, which is why the key is composite. Partitioning is applied in
/// the first migration because retrofitting it onto a live table is a migration
/// nobody wants to write (docs/07 s8, docs/17 s4).
model AuditLog {
  id                  String    @default(uuid(7)) @db.Uuid
  schoolId            String    @map("school_id") @db.Uuid
  actorUserId         String?   @map("actor_user_id") @db.Uuid
  actorType           ActorType @default(USER) @map("actor_type")
  /// Set when a platform user is impersonating. Never null for an impersonated
  /// session, so "who really did this" is always answerable.
  actorPlatformUserId String?   @map("actor_platform_user_id") @db.Uuid
  action              String
  entityType          String    @map("entity_type")
  entityId            String?   @map("entity_id")
  before              Json?
  after               Json?
  ip                  String?
  userAgent           String?   @map("user_agent")
  requestId           String?   @map("request_id")
  at                  DateTime  @default(now()) @db.Timestamptz(6)

  @@id([id, at])
  @@index([schoolId, entityType, entityId, at(sort: Desc)])
  @@index([schoolId, actorUserId, at(sort: Desc)])
  @@index([schoolId, at(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Academic structure — Phase 1.
//
// **Sessions are the axis of everything** (docs/07 section 3). `sessionId` sits
// on sections, enrollments, fee assignments, attendance and exams from the
// first migration that introduces them. That is what makes year rollover a
// supported operation — clone sections, promote students, clone fee plans —
// rather than a data migration written under pressure every July.
// ---------------------------------------------------------------------------

enum SessionStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@map("session_status")
}

model AcademicSession {
  id        String        @id @default(uuid(7)) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  name      String
  startDate DateTime      @map("start_date") @db.Date
  endDate   DateTime      @map("end_date") @db.Date
  status    SessionStatus @default(PLANNED)
  /// Exactly one per school, enforced by a partial unique index in the
  /// migration — Prisma cannot express `WHERE is_current`.
  isCurrent Boolean       @default(false) @map("is_current")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections          Section[]
  enrollments       Enrollment[]
  holidays          Holiday[]
  expenses          Expense[]
  feeVouchers       FeeVoucher[]
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

/// A grade, independent of any session: "Grade 5" exists across years.
model ClassLevel {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String
  /// Sort order, and what promotion increments. Nursery may be 0, Grade 1 is 1.
  numericOrder Int      @map("numeric_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections          Section[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, name])
  @@index([schoolId, numericOrder])
  @@map("class_levels")
}

/// A class level within one session: "Grade 5 — A, 2026-2027".
model Section {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  name         String
  capacity     Int?
  room         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session           AcademicSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel        ClassLevel         @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, sessionId, classLevelId, name])
  @@index([schoolId, sessionId])
  @@index([schoolId, classLevelId])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// People — Phase 1.
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  LEFT
  STRUCK_OFF

  @@map("student_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

/// A person enrolled at the school.
///
/// The student is the *person*; which class they are in is an `Enrollment`,
/// because that changes every year and the history is the point — a transcript
/// is the enrolment record, not the current row.
model Student {
  id               String        @id @default(uuid(7)) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  /// The General Register number — the school's permanent record of a child,
  /// and in Pakistan the one the register is legally kept against. Issued once,
  /// never reused, never changed, and it survives the student leaving.
  ///
  /// Distinct from `admissionNo` because the two answer different questions:
  /// GR is "which entry in this school's register", admission is "which intake".
  /// A school that uses one number for both simply mirrors them.
  grNo             String        @map("gr_no")
  /// The school's **Student ID** — printed on the card and the fee voucher.
  /// From `number_sequences`, gapless per school. Never a count of rows.
  ///
  /// Named `studentCode`, not `studentId`: that name already means the
  /// internal UUID on every table that points at a student, and one identifier
  /// with two meanings is a join written against the wrong one.
  studentCode      String        @map("student_code")
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  gender           Gender?
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  photoUrl         String?       @map("photo_url")
  /// Encrypted column-side. Collecting it at all is a per-school setting,
  /// never a required product field (docs/17 section 2).
  bFormNo          String?       @map("b_form_no")
  religion         String?
  bloodGroup       String?       @map("blood_group")
  nationality      String?
  address          String?
  city             String?
  emergencyContact String?       @map("emergency_contact")
  status           StudentStatus @default(ACTIVE)
  admittedOn       DateTime?     @map("admitted_on") @db.Date
  leftOn           DateTime?     @map("left_on") @db.Date
  leavingReason    String?       @map("leaving_reason")
  /// Set when the student has a portal login of their own.
  userId           String?       @map("user_id") @db.Uuid
  /// The pressure valve: a school adds its own fields rather than asking for a
  /// migration and a code branch (docs/07 section 4).
  custom           Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments       Enrollment[]
  guardians         StudentGuardian[]
  fees              StudentFee[]
  feeVouchers       FeeVoucher[]
  feeVoucherPeriods FeeVoucherPeriod[]
  feePayments       FeePayment[]
  attendanceRecords AttendanceRecord[]
  securityDeposits  SecurityDeposit[]

  @@unique([schoolId, studentCode])
  @@unique([schoolId, grNo])
  @@index([schoolId, status, lastName])
  @@index([schoolId, studentCode])
  @@index([schoolId, grNo])
  @@map("students")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN

  @@map("guardian_relation")
}

/// One guardian, many children — across classes and across years. That is why
/// this is its own table rather than columns on `students`: the sibling
/// discount and "one message to the family" both depend on it (docs/07 s4).
model Guardian {
  id         String           @id @default(uuid(7)) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  name       String
  relation   GuardianRelation
  /// Encrypted column-side, like b_form_no.
  cnic       String?
  phone      String?
  whatsapp   String?
  email      String?
  occupation String?
  address    String?
  userId     String?          @map("user_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@index([schoolId, name])
  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  guardianId String   @map("guardian_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  /// Who the fee voucher is addressed to, which is not always the primary
  /// contact.
  isFeePayer Boolean  @default(false) @map("is_fee_payer")
  canPickup  Boolean  @default(true) @map("can_pickup")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, guardianId])
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  TRANSFERRED
  LEFT

  @@map("enrollment_status")
}

/// A student in one class, for one session. The row year rollover writes.
model Enrollment {
  id           String           @id @default(uuid(7)) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  classLevelId String           @map("class_level_id") @db.Uuid
  sectionId    String?          @map("section_id") @db.Uuid
  rollNo       Int?             @map("roll_no")
  status       EnrollmentStatus @default(ENROLLED)
  enrolledOn   DateTime?        @map("enrolled_on") @db.Date
  endedOn      DateTime?        @map("ended_on") @db.Date
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  section    Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// One enrolment per student per session. This is what stops a student being
  /// enrolled twice and then billed twice.
  @@unique([schoolId, sessionId, studentId])
  @@index([schoolId, sessionId, sectionId])
  @@index([schoolId, studentId])
  @@map("enrollments")
}

/// Gapless per-school counters for admission numbers, receipt numbers and
/// voucher numbers.
///
/// A number is allocated by incrementing this row inside the same transaction
/// as the insert that uses it. The alternative — `count(*) + 1` — hands two
/// receptionists admitting at the same instant the same admission number, and
/// a school that finds two children sharing one stops trusting the register.
///
/// A PostgreSQL sequence would not do: sequences deliberately leak numbers on
/// rollback, and an audited register may not have holes in it.
/// What someone does at the school — docs/07 §4.
///
/// Separate from `SchoolRole`, which is about **what the portal lets you do**.
/// A janitor and a security guard are employees with leave and a salary and no
/// reason to have a login at all; a head and an admin need both. Collapsing the
/// two would either invent portal accounts for people who never sign in, or
/// leave half the payroll unrecorded.
enum StaffRole {
  HEAD
  ADMIN
  OFFICE_STAFF
  TEACHER
  SECURITY_GUARD
  JANITOR

  @@map("staff_role")
}

enum StaffStatus {
  ACTIVE
  /// Employment ended. The record stays — it is the answer to "who worked here
  /// in 2026", which payroll and any inspection will ask.
  LEFT

  @@map("staff_status")
}

/// An employee. docs/07 §4.
///
/// `userId` is nullable and that is the crux of this table: a staff record is
/// an employment fact, and a portal account is an access grant. Most schools
/// have people with one and not the other in both directions.
model Staff {
  id           String      @id @default(uuid(7)) @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  /// Gapless per-school counter, like GR numbers. Printed on payroll.
  employeeNo   String      @map("employee_no")
  /// Their portal login, when they have one.
  userId       String?     @unique @map("user_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  gender       Gender?
  role         StaffRole
  /// Annual allowance, in days. Attendance draws these down in Phase 3.
  casualLeaves Int         @default(0) @map("casual_leaves")
  sickLeaves   Int         @default(0) @map("sick_leaves")
  /// Rupees, `numeric(14,2)`. Integer paisa above the service layer, like fees.
  basicSalary  Decimal     @default(0) @map("basic_salary") @db.Decimal(14, 2)
  status       StaffStatus @default(ACTIVE)
  joinedOn     DateTime?   @map("joined_on") @db.Date
  leftOn       DateTime?   @map("left_on") @db.Date
  cnic         String?
  designation  String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete: a payroll record that vanishes takes the answer to "were they
  /// ever employed here" with it.
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffAttendanceRecords StaffAttendanceRecord[]

  @@unique([schoolId, employeeNo])
  @@index([schoolId, status, name])
  @@index([schoolId, role])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// Expenses — docs/07 §7, docs/modules/fees-and-finance.md §Expenses.
//
// Money is `numeric(14,2)` rupees here and integer paisa above the service
// layer, exactly as for fees. The field names avoid `Minor` for the same reason
// they do there: a `Decimal` called `amountMinor` would be a lie.
// ---------------------------------------------------------------------------

/// The old "Expense Type" screen, which this replaces.
///
/// School-configurable rather than a fixed enum: every school groups its
/// spending differently, and a hard-coded list is exactly the school-specific
/// branching CLAUDE.md R1 forbids.
model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  /// Maps into the expense side of the day book when Phase 4 lands.
  glCode    String?  @map("gl_code")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive, sortOrder])
  @@map("expense_categories")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER

  @@map("payment_method")
}

/// One thing the school spent money on.
///
/// Attached to a **session** as well as a date, because a school reports
/// spending per academic year and "what did we spend in 2026–27" should not be
/// a date-range query somebody has to get right by hand.
model Expense {
  id          String        @id @default(uuid(7)) @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  sessionId   String        @map("session_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  /// Gapless per-school counter. What a paper voucher would carry.
  voucherNo   String        @map("voucher_no")
  description String
  payee       String?
  /// Rupees, `numeric(14,2)`.
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(CASH)
  paidOn      DateTime      @map("paid_on") @db.Date
  reference   String?
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([schoolId, voucherNo])
  /// The list's default view — one session, newest first. Without this index a
  /// school with four years of spending scans the table on every page load.
  @@index([schoolId, sessionId, paidOn(sort: Desc)])
  @@index([schoolId, categoryId])
  @@map("expenses")
}

enum HolidayType {
  HOLIDAY
  VACATION
  EVENT

  @@map("holiday_type")
}

/// Who a non-teaching day applies to. An in-service training day closes the
/// school to students and not to staff, and attendance must know the difference
/// or it marks the whole roll absent.
enum HolidayAudience {
  ALL
  STUDENTS
  STAFF

  @@map("holiday_audience")
}

/// A day the school is not running normally — docs/07 §3.
///
/// A **range**, not one row per day: "Summer vacation, 1 June to 15 August" is
/// one thing a school declares and one thing it later edits, and storing 76
/// rows for it makes "move the end date" a delete-and-recreate that loses the
/// name. `startDate == endDate` is the ordinary single-day case.
///
/// Attached to a session because a school calendar belongs to an academic year;
/// the same date in the next session is a different decision.
model Holiday {
  id        String          @id @default(uuid(7)) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  name      String
  type      HolidayType     @default(HOLIDAY)
  appliesTo HolidayAudience @default(ALL) @map("applies_to")
  startDate DateTime        @map("start_date") @db.Date
  /// Inclusive. Equal to `startDate` for a single day.
  endDate   DateTime        @map("end_date") @db.Date
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([schoolId, sessionId, startDate])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Fees — the catalogue, and what each child was actually agreed to pay.
//
// This is the first slice of the Phase 2 engine (docs/modules/fees-and-finance.md
// §2). It deliberately stops short of fee *plans*, billing periods and voucher
// generation: those need a session axis and a batch engine, and a school cannot
// use any of it until it can first say "these are our fees, and this child pays
// this much".
//
// ## Money lives in two shapes, on purpose
//
// CLAUDE.md: integer minor units (paisa) in code, `numeric(14,2)` in the
// database. So the columns below are `Decimal` **in rupees**, and the field
// names deliberately do NOT end in `Minor` — a `Decimal` called `amountMinor`
// would be a lie that a reader would eventually act on. Conversion happens in
// exactly one place, `FeeHeadsService`/`StudentsService`, using
// `fromDecimalString`/`toDecimalString` from `@ilm/utils`. Every contract, every
// service signature and every component past that boundary is integer paisa
// named `...Minor`.
// ---------------------------------------------------------------------------

/// What kind of charge this is. Drives nothing structural yet; it groups the
/// catalogue and lets a school recognise its own list at a glance.
///
/// `SECURITY` is refundable and is never income (docs/modules/fees-and-finance
/// §2). Nothing depends on that yet, but the distinction has to exist in the
/// data from the first row or it cannot be recovered later.
enum FeeHeadType {
  ADMISSION
  TUITION
  ANNUAL
  LAB
  STATIONERY
  SECURITY
  TRANSPORT
  EXAM
  CUSTOM

  @@map("fee_head_type")
}

/// One line a school charges for. The catalogue behind Settings › Fees.
///
/// A head in use is never deleted, only deactivated — deleting one would
/// orphan the amount every existing student was admitted on.
model FeeHead {
  id            String       @id @default(uuid(7)) @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  type          FeeHeadType  @default(CUSTOM)
  name          String
  /// Rupees, `numeric(14,2)`. Read as integer paisa above the service layer.
  defaultAmount Decimal      @map("default_amount") @db.Decimal(14, 2)
  /// Printed order on a voucher, and the order of the fields on the admission
  /// form. Schools care about this more than you would expect.
  sortOrder     Int          @default(0) @map("sort_order")
  isActive      Boolean      @default(true) @map("is_active")
  /// How often this head is charged. Generation needs it: without it, billing
  /// three months at once would charge three admission fees.
  frequency     FeeFrequency @default(MONTHLY)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees    StudentFee[]
  voucherLines   FeeVoucherLine[]
  voucherPeriods FeeVoucherPeriod[]

  /// Two heads called "Tuition Fee" is a school arguing with itself about which
  /// one a voucher meant.
  @@unique([schoolId, name])
  @@index([schoolId, isActive, sortOrder])
  @@map("fee_heads")
}

/// What one child was agreed to pay for one head, fixed at admission.
///
/// `amount` is **copied** from the head rather than joined to it, and that is
/// the single most important decision in this file. The module's founding rule
/// is that changing a fee does not retroactively change what was already agreed
/// (docs/modules/fees-and-finance.md §1) — a school that raises tuition in
/// April must not silently restate what every existing child owes for March.
/// A join would do exactly that.
///
/// `discountedAmount` null means no discount. When set, it **is** the amount
/// payable — not a delta — because that is how a school states it out loud
/// ("we agreed 10,000 instead of 25,000"), and storing the sentence people
/// actually say removes an arithmetic step that can be got wrong in either
/// direction.
model StudentFee {
  id        String @id @default(uuid(7)) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  feeHeadId String @map("fee_head_id") @db.Uuid

  /// Rupees, `numeric(14,2)`. The standard amount at the moment of admission.
  amount           Decimal  @map("amount") @db.Decimal(14, 2)
  /// Rupees. Null unless a discount was agreed; then this is what is payable.
  discountedAmount Decimal? @map("discounted_amount") @db.Decimal(14, 2)
  /// Why the school gave it. Blank is allowed; unanswerable is not.
  discountReason   String?  @map("discount_reason")

  /// The day this amount starts applying.
  ///
  /// The amount in force on any date is the newest row not in the future, so a
  /// fee rise scheduled for next month sits here harmlessly until then. Old
  /// rows stay: overwriting one would rewrite what a parent was charged in a
  /// month that has already been billed and receipted.
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  /// One amount per head per day. A double-clicked Submit is an upsert, not a
  /// second row.
  @@unique([schoolId, studentId, feeHeadId, effectiveFrom])
  /// Walks backwards from the billing date and stops at the first hit per head.
  @@index([schoolId, studentId, feeHeadId, effectiveFrom(sort: Desc)])
  @@index([schoolId, studentId])
  @@index([schoolId, feeHeadId])
  @@map("student_fees")
}

model NumberSequence {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  /// `student` · `gr` · `receipt` · `voucher`.
  kind      String
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind])
  @@index([schoolId, kind])
  @@map("number_sequences")
}

// ===========================================================================
// Fee vouchers, payments, and the batch engine — docs/modules/fees-and-finance
// §5–§7. Migration 20260907000000_fee_vouchers carries the CHECK constraints
// that hold the financial invariants, so they are enforced by the database
// rather than only by the service: no code path can break them.
// ===========================================================================

enum JobRunStatus {
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK

  @@map("job_run_status")
}

/// One run of a batch operation — CLAUDE.md R5.
///
/// Keyed by an idempotency key so a retried request replays the finished
/// result instead of doing the work twice, and carries a cursor so a run that
/// dies halfway resumes rather than restarting.
model JobRun {
  id             String       @id @default(uuid(7)) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  /// `fee-voucher-generation`, and whatever comes next.
  kind           String
  idempotencyKey String       @map("idempotency_key")
  status         JobRunStatus @default(RUNNING)
  params         Json         @default("{}")
  /// Opaque to everything but the job that wrote it.
  cursor         String?
  total          Int          @default(0)
  processed      Int          @default(0)
  succeeded      Int          @default(0)
  skipped        Int          @default(0)
  failed         Int          @default(0)
  result         Json?
  error          String?
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vouchers FeeVoucher[]

  @@unique([schoolId, kind, idempotencyKey])
  @@index([schoolId, kind, startedAt(sort: Desc)])
  @@map("job_runs")
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME

  @@map("fee_frequency")
}

enum VoucherStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED

  @@map("voucher_status")
}

enum VoucherLineKind {
  FEE
  ARREAR
  LATE_FEE
  WAIVER
  ADJUSTMENT

  @@map("voucher_line_kind")
}

enum FeePaymentStatus {
  CONFIRMED
  REVERSED

  @@map("fee_payment_status")
}

/// One challan for one student, frozen at generation.
model FeeVoucher {
  id        String        @id @default(uuid(7)) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  studentId String        @map("student_id") @db.Uuid
  voucherNo String        @map("voucher_no")
  status    VoucherStatus @default(UNPAID)

  issueDate DateTime @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date
  validTill DateTime @map("valid_till") @db.Date

  /// First-of-month dates this voucher bills. Denormalised from the lines
  /// because the list renders it on every row.
  billMonths DateTime[] @map("bill_months") @db.Date

  /// All rupees, `numeric(14,2)`. Integer paisa above the service layer.
  grossAmount    Decimal @default(0) @map("gross_amount") @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  waiverAmount   Decimal @default(0) @map("waiver_amount") @db.Decimal(14, 2)
  arrearsAmount  Decimal @default(0) @map("arrears_amount") @db.Decimal(14, 2)
  /// Payable **within** the due date.
  netPayable     Decimal @default(0) @map("net_payable") @db.Decimal(14, 2)
  /// The surcharge after it — deliberately outside `netPayable`, because the
  /// challan prints the two as different numbers.
  lateFeeAmount  Decimal @default(0) @map("late_fee_amount") @db.Decimal(14, 2)
  lateFeeAuto    Boolean @default(true) @map("late_fee_auto")

  paidAmount Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paidOn     DateTime? @map("paid_on") @db.Date

  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason")

  jobRunId  String?  @map("job_run_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  jobRun  JobRun?         @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  lines       FeeVoucherLine[]
  periods     FeeVoucherPeriod[]
  allocations FeePaymentAllocation[]
  /// The prior vouchers this one carries.
  arrears     FeeVoucherArrear[]     @relation("VoucherArrears")
  /// The later vouchers carrying this one.
  carriedInto FeeVoucherArrear[]     @relation("ArrearSource")
  /// The deposit this voucher collected. At most one — enforced by the unique
  /// index on (school, voucher) rather than by a 1-1 relation, because Prisma's
  /// 1-1 needs the foreign key unique on its own and every index on a tenant
  /// table leads with `school_id` (CLAUDE.md).
  securityDeposits SecurityDeposit[]

  @@unique([schoolId, voucherNo])
  @@index([schoolId, sessionId, issueDate(sort: Desc)])
  @@index([schoolId, studentId, status])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, jobRunId])
  @@map("fee_vouchers")
}

/// One printed row on a challan. `label` is a snapshot: renaming a fee head
/// later must not rewrite what an issued voucher said.
model FeeVoucherLine {
  id        String          @id @default(uuid(7)) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  voucherId String          @map("voucher_id") @db.Uuid
  feeHeadId String?         @map("fee_head_id") @db.Uuid
  kind      VoucherLineKind @default(FEE)
  label     String
  billMonth DateTime?       @map("bill_month") @db.Date
  amount    Decimal         @db.Decimal(14, 2)
  discount  Decimal         @default(0) @db.Decimal(14, 2)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  feeHead FeeHead?   @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([schoolId, voucherId, sortOrder])
  @@map("fee_voucher_lines")
}

/// A claim on (student, head, period). The unique index is what makes
/// double-billing impossible rather than unlikely. Rows are deleted when a
/// voucher is cancelled, which frees the period to be generated again.
model FeeVoucherPeriod {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  voucherId String   @map("voucher_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  feeHeadId String   @map("fee_head_id") @db.Uuid
  /// `2026-09` monthly, `session:<uuid>` annual, `once` one-time.
  periodKey String   @map("period_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([schoolId, studentId, feeHeadId, periodKey], map: "fee_voucher_periods_school_id_student_id_fee_head_id_period_key")
  @@index([schoolId, voucherId])
  @@map("fee_voucher_periods")
}

/// Which prior vouchers an arrears figure is made of, so that paying it
/// actually settles them.
model FeeVoucherArrear {
  id              String  @id @default(uuid(7)) @db.Uuid
  schoolId        String  @map("school_id") @db.Uuid
  voucherId       String  @map("voucher_id") @db.Uuid
  sourceVoucherId String  @map("source_voucher_id") @db.Uuid
  amount          Decimal @db.Decimal(14, 2)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  voucher FeeVoucher @relation("VoucherArrears", fields: [voucherId], references: [id], onDelete: Cascade)
  source  FeeVoucher @relation("ArrearSource", fields: [sourceVoucherId], references: [id], onDelete: Restrict)

  @@unique([schoolId, voucherId, sourceVoucherId], map: "fee_voucher_arrears_school_id_voucher_id_source_key")
  @@map("fee_voucher_arrears")
}

/// Append-only. Never edited, never deleted; a correction is a reversal row.
model FeePayment {
  id                String           @id @default(uuid(7)) @db.Uuid
  schoolId          String           @map("school_id") @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  receiptNo         String           @map("receipt_no")
  amount            Decimal          @db.Decimal(14, 2)
  method            PaymentMethod    @default(CASH)
  paidOn            DateTime         @map("paid_on") @db.Date
  reference         String?
  status            FeePaymentStatus @default(CONFIRMED)
  reversesPaymentId String?          @map("reverses_payment_id") @db.Uuid
  reason            String?
  idempotencyKey    String?          @map("idempotency_key")
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reverses   FeePayment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy FeePayment[] @relation("PaymentReversal")

  allocations FeePaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, studentId, paidOn(sort: Desc)])
  @@index([schoolId, paidOn(sort: Desc)])
  @@map("fee_payments")
}

/// Which voucher got which rupee — docs/modules §7, invariant 3.
model FeePaymentAllocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  voucherId String   @map("voucher_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@unique([schoolId, paymentId, voucherId], map: "fee_payment_allocations_school_id_payment_id_voucher_id_key")
  @@index([schoolId, voucherId])
  @@map("fee_payment_allocations")
}

// ===========================================================================
// Attendance — docs/modules/attendance-and-exams.md Part A.
//
// Migration 20260908000000_attendance range-partitions `attendance_records` by
// month and secures every partition individually, because RLS on a partitioned
// parent does not protect a partition queried directly.
// ===========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
  EXCUSED

  @@map("attendance_status")
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK_LEAVE
  CASUAL_LEAVE
  HALF_DAY

  @@map("staff_attendance_status")
}

/// One mark for one student on one day.
///
/// The unique key includes `date` because it is the partition key, and
/// `period` because DAILY is one mode of three (docs §2) and adding a column
/// to a unique index over millions of rows later is not a migration anybody
/// wants to run.
model AttendanceRecord {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  classLevelId String           @map("class_level_id") @db.Uuid
  /// Denormalised at marking time, so moving a child between sections does not
  /// rewrite the register behind them.
  sectionId    String?          @map("section_id") @db.Uuid
  date         DateTime         @db.Date
  /// 0 for DAILY marking, which is what every school starts on.
  period       Int              @default(0) @db.SmallInt
  status       AttendanceStatus
  note         String?
  markedBy     String?          @map("marked_by") @db.Uuid
  markedAt     DateTime         @default(now()) @map("marked_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  section    Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([schoolId, studentId, date, period], map: "attendance_records_school_student_date_period_key")
  @@index([schoolId, sectionId, date], map: "attendance_records_school_section_date_idx")
  @@index([schoolId, classLevelId, date], map: "attendance_records_school_class_date_idx")
  @@index([schoolId, date, status], map: "attendance_records_school_date_status_idx")
  @@map("attendance_records")
}

/// The same engine, a different subject and a different set of statuses.
model StaffAttendanceRecord {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String                @map("school_id") @db.Uuid
  staffId      String                @map("staff_id") @db.Uuid
  date         DateTime              @db.Date
  status       StaffAttendanceStatus
  checkedInAt  DateTime?             @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt DateTime?             @map("checked_out_at") @db.Timestamptz(6)
  note         String?
  markedBy     String?               @map("marked_by") @db.Uuid
  markedAt     DateTime              @default(now()) @map("marked_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffId, date], map: "staff_attendance_records_school_staff_date_key")
  @@index([schoolId, date], map: "staff_attendance_records_school_date_idx")
  @@index([schoolId, staffId, date(sort: Desc)], map: "staff_attendance_records_school_staff_date_idx")
  @@map("staff_attendance_records")
}

/// Money the school is holding on a parent's behalf, not money it has earned.
///
/// A fee is income the moment it is collected. A deposit is a liability: the
/// school owes it back, less whatever the child broke. Keeping the two in one
/// table would overstate a year's collection by the whole float, which is the
/// kind of error an accountant finds and never quite trusts you about again.
model SecurityDeposit {
  id        String  @id @default(uuid(7)) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  /// The voucher that collected it, when it arrived on one. Null for a deposit
  /// taken at the counter outside a billing run.
  voucherId String? @map("voucher_id") @db.Uuid

  /// Rupees, `numeric(14,2)`. Read as integer paisa above the service layer.
  amount     Decimal  @db.Decimal(14, 2)
  receivedOn DateTime @map("received_on") @db.Date
  note       String?
  createdBy  String?  @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  voucher FeeVoucher?             @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  refunds SecurityDepositRefund[]

  /// A retried payment must not book the float twice.
  @@unique([schoolId, voucherId])
  @@index([schoolId, receivedOn(sort: Desc)])
  @@index([schoolId, studentId])
  @@map("security_deposits")
}

/// One repayment out of a deposit. Append-only (R4).
///
/// Refunding happens in pieces — 2,000 withheld for a broken window, 3,000
/// returned when the child leaves — so what is left is arithmetic over these
/// rows, never a counter updated in place. A counter loses the answer to "who
/// returned what, when, and why", which is the only question anybody asks.
model SecurityDepositRefund {
  id        String @id @default(uuid(7)) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  depositId String @map("deposit_id") @db.Uuid

  amount Decimal @db.Decimal(14, 2)
  /// Never blank. "Broken window, Class V" is the difference between a refund
  /// and an unexplained withdrawal when somebody asks in two years.
  reason String

  refundedOn DateTime @map("refunded_on") @db.Date
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deposit SecurityDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)

  @@index([schoolId, depositId])
  @@map("security_deposit_refunds")
}

/// A school's logo, kept out of `schools` so its bytes never ride along with a
/// tenant lookup. See the migration for why the bytes are in Postgres at all,
/// and what moving them out would cost.
model SchoolLogo {
  id       String @id @default(uuid(7)) @db.Uuid
  schoolId String @unique @map("school_id") @db.Uuid

  bytes    Bytes
  mimeType String @map("mime_type")
  /// Served as the HTTP ETag, so a logo shown on every page is fetched once.
  etag     String
  byteSize Int    @map("byte_size")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_logos")
}

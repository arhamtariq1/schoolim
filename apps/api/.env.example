# The API's environment. Copy to `.env` and fill in. Never commit `.env`.
#
# Per app rather than one file at the repo root: the portal cannot use a
# database URL — a lint rule forbids it importing Prisma — so keeping one there
# would be dead weight and a second place for a secret to leak from.

NODE_ENV=development

# --- Database -------------------------------------------------------------
# ONE database, reached by TWO roles. That is not duplication:
#
#   DATABASE_URL        ilm_app  — NOBYPASSRLS. Every request runs as this.
#   DATABASE_ADMIN_URL  postgres — migrations, and resolving a hostname to a
#                                  school before any tenant context exists.
#
# **The split is the third layer of tenant isolation.** PostgreSQL exempts a
# superuser from row-level security even with FORCE enabled, so pointing
# DATABASE_URL at the owner would make `set_config('app.school_id', …)`
# decorative and every query would return every school's rows. The isolation
# suite in `src/prisma` proves this rather than asserting it.
#
# `ilm_app` must exist BEFORE the first migration — the migrations GRANT to it
# by name. Create it with:  node tooling/scripts/provision-app-role.mjs
# It reads the password out of DATABASE_URL, so the two cannot drift.
#
# A password containing `@ : / ?` must be percent-encoded (`@` becomes `%40`).
# Left raw, the URL parses the rest as the hostname and fails with a
# name-resolution error rather than an authentication one.
#
# Local — your own PostgreSQL, the one pgAdmin installs. Create the database
# once:  CREATE DATABASE ilm TEMPLATE template0 ENCODING 'UTF8';
DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5432/ilm?schema=public"
DATABASE_ADMIN_URL="postgresql://postgres:<your-password>@localhost:5432/ilm?schema=public"

# Local — the server bundled with the repo (`pnpm db`). Port must match
# tooling/scripts/local-db.mjs.
# DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5433/ilm?schema=public"
# DATABASE_ADMIN_URL="postgresql://ilm:ilm_local_dev@localhost:5433/ilm?schema=public"

# Deployed — the database sits next to the API (docs/13 §2), not a region away:
# every query costs one round trip, so a request making ten of them pays the
# distance ten times.

# --- Auth -----------------------------------------------------------------
# 32 bytes minimum. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-32-chars-minimum-for-local-dev-only"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN: leave unset. Session cookies are then host-only, so a browser
# holding demo.<domain>'s token never transmits it to beacon.<domain> at all.
# Setting it to the apex shares one cookie across every tenant subdomain and
# turns any one school's XSS into a foothold against the others.
# COOKIE_DOMAIN=""

# --- HTTP -----------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
# Where the portal is served. Used only to build absolute links back to it —
# the sign-in handoff (ADR-0009) and the email-confirmation link.
WEB_URL="http://localhost:3000"
# The apex that school subdomains hang off, e.g. `example.pk` for
# `beacon.example.pk`.
APP_DOMAIN="localhost"
# `subdomain` (default) or `path`. Must match the portal's
# NEXT_PUBLIC_PORTAL_TENANT_MODE. See docs/SINGLE-HOST-MODE.md.
# PORTAL_TENANT_MODE=subdomain

# --- Mail (ADR-0011) ------------------------------------------------------
# "log" sends nothing and logs the subject; "smtp" actually sends. The default
# is "log" on purpose — a half-configured environment should send no mail rather
# than send it from an unintended identity.
MAIL_DRIVER="log"
SMTP_HOST="localhost"
SMTP_PORT=1025
# true only for port 465 (implicit TLS). Port 587 is STARTTLS and must be false;
# true there hangs until the socket times out.
SMTP_SECURE=false
# Leave both unset for mailpit, which refuses an empty AUTH. Set them for a real
# relay. Most relays reject a From that is not the authenticated account, so
# MAIL_FROM normally equals SMTP_USER.
# SMTP_USER=""
# SMTP_PASS=""
MAIL_FROM="no-reply@localhost"

LOG_LEVEL="debug"

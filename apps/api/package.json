{
  "name": "@ilm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node ../../tooling/scripts/dev-api.mjs",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "db:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@ilm/config": "workspace:*",
    "@ilm/contracts": "workspace:*",
    "@ilm/utils": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}

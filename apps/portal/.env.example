# The portal's environment. Copy to `.env` and fill in. Never commit `.env`.
#
# There is deliberately no database URL, no JWT secret and no SMTP password
# here. The portal never talks to the database — a lint rule forbids it
# importing Prisma, because bundling the client into a frontend would make
# tenant enforcement bypassable (docs/06 §2) — and it reaches the API over HTTP
# through its own `/api/v1` proxy.

# Where the API is. `app/api/v1/[...path]` forwards to it server-side, so the
# browser only ever talks to this origin and the session cookie stays
# first-party: no CORS with credentials, no SameSite=None.
API_URL="http://localhost:4000"

# The apex that school subdomains hang off. Locally that means
# http://demo.localhost:3000 is a school's portal and http://localhost:3000 is
# the landing page and signup (ADR-0009, ADR-0010).
APP_DOMAIN="localhost"
# The same value, readable in the browser: the signup form shows the address a
# school will live at as its name is typed, and a server-only variable would be
# an empty string there.
NEXT_PUBLIC_APP_DOMAIN="localhost"

# Set to `path` ONLY on a host that cannot issue wildcard subdomains — the
# school then moves from the subdomain into the first path segment
# (`/beacon/students`). It costs the per-school cookie jar, so it is for a demo
# and not for paying schools. Must match the API's PORTAL_TENANT_MODE.
#
# NEXT_PUBLIC_ is inlined at BUILD time: changing this needs a rebuild, not a
# restart. See docs/SINGLE-HOST-MODE.md.
# NEXT_PUBLIC_PORTAL_TENANT_MODE=path

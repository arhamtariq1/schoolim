// Schema v0 — Phase 0 foundation: tenancy, identity, audit. No features.
//
// Rules that apply to every model below, so they are not repeated (CLAUDE.md):
//   1. Every tenant-scoped table carries `school_id uuid NOT NULL`.
//   2. Every tenant-scoped table has RLS enabled AND forced, with the
//      `tenant_isolation` policy. Applied in the migration, checked by
//      `tooling/scripts/check-rls.mjs` in CI.
//   3. Every index on a tenant table leads with `school_id`.
//   4. Every tenant model is registered in TENANT_MODELS.
//
// Money is `numeric(14,2)` here and integer paisa in code (ADR-0007). No money
// appears in this migration; the rule is stated so it is not re-litigated.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  // Prisma 7 generates ESM by default and its client uses import.meta.url,
  // which forces Node to parse the file as ESM. apps/api is CommonJS because
  // NestJS needs legacy decorators and emitDecoratorMetadata (docs/05), so the
  // generated client must be CommonJS too.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform — outside tenancy. No `school_id`, no tenant RLS policy.
// Reachable only by the platform role; the application role has no grant.
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING

  @@map("platform_role")
}

/// Platform staff. A separate table from `users` with its own login route and
/// cookie, so a tenant JWT can never satisfy a platform guard (docs/04 s6).
model PlatformUser {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  /// TOTP secret. 2FA is mandatory here: this account reaches every school.
  mfaSecret    String?      @map("mfa_secret")
  mfaEnabledAt DateTime?    @map("mfa_enabled_at") @db.Timestamptz(6)
  role         PlatformRole
  /// Bumped to invalidate every issued token for this account at once.
  tokenVersion Int          @default(0) @map("token_version")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions PlatformSession[]

  @@map("platform_users")
}

/// Platform staff sessions. A separate table from `sessions`, not a nullable
/// `school_id` on that one: `sessions.school_id` is NOT NULL and carries the
/// tenant_isolation policy, and relaxing it to fit three staff accounts would
/// put a hole in the mechanism that isolates every school.
///
/// Deliberately outside TENANT_MODELS: it has no `school_id` because it belongs
/// to no school. See TENANT_RLS_EXEMPT_TABLES.
model PlatformSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  platformUserId   String    @map("platform_user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  /// Hashed, never stored in the clear — same reasoning as `sessions`.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  /// Read-only. Dunning never deletes a school's data (docs/19 s4).
  SUSPENDED
  CHURNED

  @@map("school_status")
}

enum BillingMode {
  PER_CAMPUS
  CONSOLIDATED

  @@map("billing_mode")
}

/// Reserved by the first migration, unused until Phase 9. See ADR-0008.
/// Present now because adding a parent above `schools` later is a far more
/// disruptive migration than carrying a nullable foreign key from the start.
model SchoolGroup {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String       @unique
  legalName   String?      @map("legal_name")
  logoUrl     String?      @map("logo_url")
  billingMode BillingMode  @default(PER_CAMPUS) @map("billing_mode")
  status      SchoolStatus @default(TRIAL)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schools School[]

  @@map("school_groups")
}

/// One row is one campus. A standalone school has `schoolGroupId` null.
/// This is the tenant root: `school_id` on every other table points here.
model School {
  id            String       @id @default(uuid(7)) @db.Uuid
  schoolGroupId String?      @map("school_group_id") @db.Uuid
  name          String
  /// Resolves the tenant from the subdomain. Never a school picker at login,
  /// which would leak the tenant list (docs/09 s2).
  slug          String       @unique
  legalName     String?      @map("legal_name")
  logoUrl       String?      @map("logo_url")
  primaryColor  String?      @map("primary_color")
  timezone      String       @default("Asia/Karachi")
  locale        String       @default("en")
  currency      String       @default("PKR")
  country       String       @default("PK")
  city          String?
  address       String?
  phone         String?
  email         String?
  status        SchoolStatus @default(TRIAL)
  onboardedAt   DateTime?    @map("onboarded_at") @db.Timestamptz(6)
  trialEndsAt   DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolGroup     SchoolGroup?    @relation(fields: [schoolGroupId], references: [id], onDelete: Restrict)
  domains          SchoolDomain[]
  users            User[]
  userRoles        UserRole[]
  sessions         Session[]
  invitations      Invitation[]
  passwordResets   PasswordReset[]
  academicSessions AcademicSession[]
  classLevels      ClassLevel[]
  schoolSections   Section[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  enrollments      Enrollment[]
  numberSequences  NumberSequence[]

  @@index([schoolGroupId])
  @@index([status])
  @@map("schools")
}

/// Custom domains, in addition to the `{slug}` subdomain. The TenantGuard
/// matches the request host against these, and a host that disagrees with the
/// JWT tenant claim is a 401 (docs/04 s2).
model SchoolDomain {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  domain     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_domains")
}

// ---------------------------------------------------------------------------
// Identity — tenant-scoped. RLS enabled and forced on every table below.
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// Mirrors SCHOOL_ROLES in @ilm/contracts. A test asserts the two lists are
/// identical, so drift between the database and the permission matrix is a
/// failing build rather than a production surprise.
enum SchoolRole {
  OWNER
  PRINCIPAL
  ADMIN
  ACCOUNTANT
  RECEPTION
  TEACHER
  COORDINATOR
  STUDENT
  PARENT

  @@map("school_role")
}

/// A person at one school. Someone who is both a parent and a teacher at the
/// same school is ONE user with two `user_roles` rows. Someone at two schools
/// is two users — that is what keeps `school_id` on this table and makes tenant
/// isolation total (docs/07 s2).
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @map("school_id") @db.Uuid
  /// Reserved for Phase 9: one login across the campuses of a school group.
  /// Unused until then. ADR-0008.
  identityId         String?    @map("identity_id") @db.Uuid
  email              String
  phone              String?
  name               String
  passwordHash       String?    @map("password_hash")
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(INVITED)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  tokenVersion       Int        @default(0) @map("token_version")
  locale             String?
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Consecutive failures, for lockout. Reset on a successful login.
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles          UserRole[]
  sessions       Session[]
  passwordResets PasswordReset[]
  invitesSent    Invitation[]    @relation("InvitedBy")

  /// Email is unique per school, not globally: the same person may hold an
  /// account at two schools with the same address.
  @@unique([schoolId, email])
  @@index([schoolId, status])
  @@index([schoolId, email])
  @@index([schoolId, phone])
  @@map("users")
}

/// Roles are additive. `scope` carries the data a scoped grant is limited to,
/// for example `{ "sectionIds": [...] }` for a teacher — scope is data compiled
/// into a query clause, never a code branch (docs/08 s5).
model UserRole {
  id        String     @id @default(uuid(7)) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      SchoolRole
  scope     Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, role])
  @@index([schoolId, userId])
  @@map("user_roles")
}

/// One refresh-token family per login. Rotation replaces the row's hash;
/// replaying a consumed token revokes the entire family (docs/11 s8).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Shared by every token issued from one login, so reuse detection can
  /// revoke the whole chain rather than a single token.
  familyId         String    @map("family_id") @db.Uuid
  /// The token itself is never stored — only a hash, like a password.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, familyId])
  @@index([schoolId, expiresAt])
  @@map("sessions")
}

model Invitation {
  id         String     @id @default(uuid(7)) @db.Uuid
  schoolId   String     @map("school_id") @db.Uuid
  email      String
  role       SchoolRole
  tokenHash  String     @unique @map("token_hash")
  invitedBy  String?    @map("invited_by") @db.Uuid
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inviter User?  @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
  @@index([schoolId, expiresAt])
  @@map("invitations")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("password_resets")
}

enum ActorType {
  USER
  /// A platform user acting through impersonation. The audit row records both
  /// the impersonated user and the platform actor (docs/17 s5).
  PLATFORM
  SYSTEM

  @@map("actor_type")
}

/// Append-only. The application role holds no UPDATE or DELETE grant on this
/// table (docs/12 R8), which is what makes an impersonation record impossible
/// to quietly remove.
///
/// Partitioned by month on `at`. PostgreSQL requires the partition key in the
/// primary key, which is why the key is composite. Partitioning is applied in
/// the first migration because retrofitting it onto a live table is a migration
/// nobody wants to write (docs/07 s8, docs/17 s4).
model AuditLog {
  id          String    @default(uuid(7)) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(USER) @map("actor_type")
  /// Set when a platform user is impersonating. Never null for an impersonated
  /// session, so "who really did this" is always answerable.
  actorPlatformUserId String? @map("actor_platform_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  at          DateTime  @default(now()) @db.Timestamptz(6)

  @@id([id, at])
  @@index([schoolId, entityType, entityId, at(sort: Desc)])
  @@index([schoolId, actorUserId, at(sort: Desc)])
  @@index([schoolId, at(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Academic structure — Phase 1.
//
// **Sessions are the axis of everything** (docs/07 section 3). `sessionId` sits
// on sections, enrollments, fee assignments, attendance and exams from the
// first migration that introduces them. That is what makes year rollover a
// supported operation — clone sections, promote students, clone fee plans —
// rather than a data migration written under pressure every July.
// ---------------------------------------------------------------------------

enum SessionStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@map("session_status")
}

model AcademicSession {
  id        String        @id @default(uuid(7)) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  name      String
  startDate DateTime      @map("start_date") @db.Date
  endDate   DateTime      @map("end_date") @db.Date
  status    SessionStatus @default(PLANNED)
  /// Exactly one per school, enforced by a partial unique index in the
  /// migration — Prisma cannot express `WHERE is_current`.
  isCurrent Boolean       @default(false) @map("is_current")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

/// A grade, independent of any session: "Grade 5" exists across years.
model ClassLevel {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String
  /// Sort order, and what promotion increments. Nursery may be 0, Grade 1 is 1.
  numericOrder Int      @map("numeric_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, numericOrder])
  @@map("class_levels")
}

/// A class level within one session: "Grade 5 — A, 2026-2027".
model Section {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  name         String
  capacity     Int?
  room         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel  ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@unique([schoolId, sessionId, classLevelId, name])
  @@index([schoolId, sessionId])
  @@index([schoolId, classLevelId])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// People — Phase 1.
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  LEFT
  STRUCK_OFF

  @@map("student_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

/// A person enrolled at the school.
///
/// The student is the *person*; which class they are in is an `Enrollment`,
/// because that changes every year and the history is the point — a transcript
/// is the enrolment record, not the current row.
model Student {
  id               String        @id @default(uuid(7)) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  /// The General Register number — the school's permanent record of a child,
  /// and in Pakistan the one the register is legally kept against. Issued once,
  /// never reused, never changed, and it survives the student leaving.
  ///
  /// Distinct from `admissionNo` because the two answer different questions:
  /// GR is "which entry in this school's register", admission is "which intake".
  /// A school that uses one number for both simply mirrors them.
  grNo             String        @map("gr_no")
  /// The school's **Student ID** — printed on the card and the fee voucher.
  /// From `number_sequences`, gapless per school. Never a count of rows.
  ///
  /// Named `studentCode`, not `studentId`: that name already means the
  /// internal UUID on every table that points at a student, and one identifier
  /// with two meanings is a join written against the wrong one.
  studentCode      String        @map("student_code")
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  gender           Gender?
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  photoUrl         String?       @map("photo_url")
  /// Encrypted column-side. Collecting it at all is a per-school setting,
  /// never a required product field (docs/17 section 2).
  bFormNo          String?       @map("b_form_no")
  religion         String?
  bloodGroup       String?       @map("blood_group")
  nationality      String?
  address          String?
  city             String?
  emergencyContact String?       @map("emergency_contact")
  status           StudentStatus @default(ACTIVE)
  admittedOn       DateTime?     @map("admitted_on") @db.Date
  leftOn           DateTime?     @map("left_on") @db.Date
  leavingReason    String?       @map("leaving_reason")
  /// Set when the student has a portal login of their own.
  userId           String?       @map("user_id") @db.Uuid
  /// The pressure valve: a school adds its own fields rather than asking for a
  /// migration and a code branch (docs/07 section 4).
  custom           Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  guardians   StudentGuardian[]

  @@unique([schoolId, studentCode])
  @@unique([schoolId, grNo])
  @@index([schoolId, status, lastName])
  @@index([schoolId, studentCode])
  @@index([schoolId, grNo])
  @@map("students")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN

  @@map("guardian_relation")
}

/// One guardian, many children — across classes and across years. That is why
/// this is its own table rather than columns on `students`: the sibling
/// discount and "one message to the family" both depend on it (docs/07 s4).
model Guardian {
  id         String           @id @default(uuid(7)) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  name       String
  relation   GuardianRelation
  /// Encrypted column-side, like b_form_no.
  cnic       String?
  phone      String?
  whatsapp   String?
  email      String?
  occupation String?
  address    String?
  userId     String?          @map("user_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@index([schoolId, name])
  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  guardianId String   @map("guardian_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  /// Who the fee voucher is addressed to, which is not always the primary
  /// contact.
  isFeePayer Boolean  @default(false) @map("is_fee_payer")
  canPickup  Boolean  @default(true) @map("can_pickup")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, guardianId])
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  TRANSFERRED
  LEFT

  @@map("enrollment_status")
}

/// A student in one class, for one session. The row year rollover writes.
model Enrollment {
  id           String           @id @default(uuid(7)) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  classLevelId String           @map("class_level_id") @db.Uuid
  sectionId    String?          @map("section_id") @db.Uuid
  rollNo       Int?             @map("roll_no")
  status       EnrollmentStatus @default(ENROLLED)
  enrolledOn   DateTime?        @map("enrolled_on") @db.Date
  endedOn      DateTime?        @map("ended_on") @db.Date
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  section    Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// One enrolment per student per session. This is what stops a student being
  /// enrolled twice and then billed twice.
  @@unique([schoolId, sessionId, studentId])
  @@index([schoolId, sessionId, sectionId])
  @@index([schoolId, studentId])
  @@map("enrollments")
}

/// Gapless per-school counters for admission numbers, receipt numbers and
/// voucher numbers.
///
/// A number is allocated by incrementing this row inside the same transaction
/// as the insert that uses it. The alternative — `count(*) + 1` — hands two
/// receptionists admitting at the same instant the same admission number, and
/// a school that finds two children sharing one stops trusting the register.
///
/// A PostgreSQL sequence would not do: sequences deliberately leak numbers on
/// rollback, and an audited register may not have holes in it.
model NumberSequence {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  /// `student` · `gr` · `receipt` · `voucher`.
  kind      String
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind])
  @@index([schoolId, kind])
  @@map("number_sequences")
}

# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- Database -------------------------------------------------------------
# NEVER put a real password in this file. It is committed. Real values go in
# .env, which is gitignored. A password containing @ : / or ? must be
# percent-encoded in a connection URL (@ becomes %40) — left raw, the URL parses
# the rest as the hostname and fails with a name-resolution error rather than an
# authentication one, which sends you looking in the wrong place.
#
# DATABASE_URL      : the APPLICATION role. No BYPASSRLS. All tenant traffic.
# DATABASE_ADMIN_URL: the OWNER role. Migrations and platform/super-admin only.
#
# The two roles are the third layer of tenant isolation, so they are genuinely
# two roles: `ilm_app` cannot bypass row-level security and the owner can. Set
# `ilm_app` up with `node tooling/scripts/provision-app-role.mjs`, which reads
# its password out of DATABASE_URL so the two cannot drift. It must exist
# BEFORE the first migration — the migrations GRANT to it by name.
#
# --- Option A: your own PostgreSQL (the one pgAdmin installs) -------------
# Nothing to start, survives a reboot, and inspectable in pgAdmin. Create the
# database once:  CREATE DATABASE ilm TEMPLATE template0 ENCODING 'UTF8';
DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5432/ilm?schema=public"
DATABASE_ADMIN_URL="postgresql://postgres:<your-password>@localhost:5432/ilm?schema=public"

# --- Option B: the server bundled with the repo ---------------------------
# `pnpm db` runs a real PostgreSQL out of node_modules. No install, no Docker,
# no admin rights. Port 5433 — it must match tooling/scripts/local-db.mjs, which
# this file previously contradicted by naming 5434.
# DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5433/ilm?schema=public"
# DATABASE_ADMIN_URL="postgresql://ilm:ilm_local_dev@localhost:5433/ilm?schema=public"

# --- Deployed -------------------------------------------------------------
# The database moves to Railway alongside the API (docs/13 §2), close to it
# rather than a region away: every query costs one network round trip, so a
# request that makes ten of them pays ten times the distance.
#
# If a managed pooler is used instead, the runtime wants the TRANSACTION pooler
# — set_config(..., true) is transaction-local and every tenant query runs
# inside a transaction, so RLS survives it — plus `?pgbouncer=true` to disable
# prepared statements, and an explicit `connection_limit`. Left unset, Prisma
# sizes the pool from the container's CPU count, which on a 2-vCPU instance is
# five connections for the whole API.
# DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=20"
# Migrations need SESSION mode, so they keep port 5432.
# DATABASE_ADMIN_URL="postgresql://...:5432/postgres"

# --- Redis (BullMQ, Phase 2+) ---------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-32-chars-minimum-for-local-dev-only"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN: leave unset. Session cookies are then host-only, so a browser
# holding demo.<domain>'s token never transmits it to beacon.<domain> at all.
# Setting it to the apex domain shares one cookie across every tenant subdomain.
# COOKIE_DOMAIN=""

# --- Domains --------------------------------------------------------------
# The apex that school subdomains hang off. Tenants resolve from the hostname,
# so the portal is reached at {slug}.<APP_DOMAIN> and the public site at the
# apex itself (ADR-0009, ADR-0010). Locally that means http://demo.localhost:3000
# for a school and http://localhost:3000 for the landing page and signup.
APP_DOMAIN="localhost"
# Same value, readable in the browser. The signup form shows "{slug}.<domain>"
# as you type, and a server-only variable is an empty string there.
NEXT_PUBLIC_APP_DOMAIN="localhost"

# --- API ------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
# Where the portal is served. The API reads this to build the sign-in handoff
# links that point back at it (ADR-0009), so a non-default port belongs here.
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
INTERNAL_JOB_SECRET="change-me-local-only"

# --- Mail (ADR-0011) ------------------------------------------------------
# MAIL_DRIVER: "log" sends nothing and logs the subject; "smtp" actually sends.
# The default is "log" on purpose — a half-configured environment should send
# no mail rather than send it from an unintended identity.
MAIL_DRIVER="smtp"

# Locally: mailpit, which accepts anything and wants no credentials.
# Inbox at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
# true only for port 465 (implicit TLS). Port 587 is STARTTLS and must be false;
# setting it true there hangs until the socket times out.
SMTP_SECURE=false
# Leave both unset for mailpit — an empty user makes nodemailer attempt AUTH
# and get refused. Set them for a real relay.
# SMTP_USER=""
# SMTP_PASS=""
# Most relays reject or rewrite a From that is not the authenticated account,
# so in deployment this equals SMTP_USER. The display name is added from BRAND.
MAIL_FROM="no-reply@localhost"

# --- Observability (optional in dev) --------------------------------------
SENTRY_DSN=""
LOG_LEVEL="debug"

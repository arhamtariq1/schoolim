# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- Database -------------------------------------------------------------
# NEVER put a real password in this file. It is committed. Real values go in
# .env, which is gitignored. A password containing @ : / or ? must be
# percent-encoded in a connection URL (@ becomes %40).
# DATABASE_URL      : the APPLICATION role. No BYPASSRLS. All tenant traffic.
# DATABASE_ADMIN_URL: the OWNER role. Migrations and platform/super-admin only.
# Local (pnpm db). These are throwaway local credentials, not secrets.
DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5434/ilm?schema=public"
DATABASE_ADMIN_URL="postgresql://ilm:ilm_local_dev@localhost:5434/ilm?schema=public"

# Supabase (deployed, Phase 0-1).
#
# ALWAYS THE POOLER, NEVER `db.<ref>.supabase.co`. The direct host publishes
# only an AAAA record — Supabase moved direct connections to IPv6-only and
# charges for the IPv4 add-on. On a network without IPv6 it fails as
# `DatabaseNotReachable`, which reads like the database is down rather than
# unreachable, and every page renders its error state. The pooler is IPv4.
#
# The pooler username is `<role>.<project-ref>`, not `<role>`.
# Region is the project's own; find it in the Supabase dashboard's connection
# string, not by guessing.
#
# SESSION pooler (5432) for migrations and, for now, runtime.
# TRANSACTION pooler (6543) is the production runtime choice: set_config(…, true)
# is transaction-local and every tenant query runs inside a transaction, so RLS
# survives it. Add `?pgbouncer=true` when switching.
# DATABASE_URL="postgresql://ilm_app.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DATABASE_ADMIN_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Redis (BullMQ, Phase 2+) ---------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-32-chars-minimum-for-local-dev-only"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN: leave unset. Session cookies are then host-only, so a browser
# holding demo.<domain>'s token never transmits it to beacon.<domain> at all.
# Setting it to the apex domain shares one cookie across every tenant subdomain.
# COOKIE_DOMAIN=""

# --- API ------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
INTERNAL_JOB_SECRET="change-me-local-only"

# --- Mail (mailpit locally, http://localhost:8025) ------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Ilm <no-reply@localhost>"

# --- Observability (optional in dev) --------------------------------------
SENTRY_DSN=""
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- Database -------------------------------------------------------------
# NEVER put a real password in this file. It is committed. Real values go in
# .env, which is gitignored. A password containing @ : / or ? must be
# percent-encoded in a connection URL (@ becomes %40).
# DATABASE_URL      : the APPLICATION role. No BYPASSRLS. All tenant traffic.
# DATABASE_ADMIN_URL: the OWNER role. Migrations and platform/super-admin only.
# Local (pnpm db). These are throwaway local credentials, not secrets.
DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5434/ilm?schema=public"
DATABASE_ADMIN_URL="postgresql://ilm:ilm_local_dev@localhost:5434/ilm?schema=public"

# Supabase (deployed, Phase 0-1).
#
# ALWAYS THE POOLER, NEVER `db.<ref>.supabase.co`. The direct host publishes
# only an AAAA record — Supabase moved direct connections to IPv6-only and
# charges for the IPv4 add-on. On a network without IPv6 it fails as
# `DatabaseNotReachable`, which reads like the database is down rather than
# unreachable, and every page renders its error state. The pooler is IPv4.
#
# The pooler username is `<role>.<project-ref>`, not `<role>`.
# Region is the project's own; find it in the Supabase dashboard's connection
# string, not by guessing.
#
# SESSION pooler (5432) for migrations and, for now, runtime.
# TRANSACTION pooler (6543) is the production runtime choice: set_config(…, true)
# is transaction-local and every tenant query runs inside a transaction, so RLS
# survives it. Add `?pgbouncer=true` when switching.
# DATABASE_URL="postgresql://ilm_app.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DATABASE_ADMIN_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# SET `connection_limit` EXPLICITLY IN PRODUCTION.
#
# Left out, Prisma derives the pool size from the container's CPU count
# (cpus * 2 + 1). On a 2-vCPU instance that is **five** connections for the
# entire API — and because every tenant-scoped read runs inside an interactive
# transaction (that is how app.school_id reaches PostgreSQL), reads contend for
# the pool exactly as writes do. Five is not enough for one school's morning,
# let alone several, and the failure is a 500 from
# `P2028: Unable to start a transaction in the given time`, not a queue.
#
# Size it against the pooler's own ceiling and the number of API instances:
#   connection_limit x instances  <=  the pooler's max client connections
# Then let it be the number you chose, not the number the scheduler happened to
# give you.
#
#   ...pooler.supabase.com:5432/postgres?connection_limit=20&pool_timeout=20

# --- Redis (BullMQ, Phase 2+) ---------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-32-chars-minimum-for-local-dev-only"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN: leave unset. Session cookies are then host-only, so a browser
# holding demo.<domain>'s token never transmits it to beacon.<domain> at all.
# Setting it to the apex domain shares one cookie across every tenant subdomain.
# COOKIE_DOMAIN=""

# --- Domains --------------------------------------------------------------
# The apex that school subdomains hang off. Tenants resolve from the hostname,
# so the portal is reached at {slug}.<APP_DOMAIN> and the public site at the
# apex itself (ADR-0009, ADR-0010). Locally that means http://demo.localhost:3000
# for a school and http://localhost:3000 for the landing page and signup.
APP_DOMAIN="localhost"
# Same value, readable in the browser. The signup form shows "{slug}.<domain>"
# as you type, and a server-only variable is an empty string there.
NEXT_PUBLIC_APP_DOMAIN="localhost"

# --- API ------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
# Where the portal is served. The API reads this to build the sign-in handoff
# links that point back at it (ADR-0009), so a non-default port belongs here.
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
INTERNAL_JOB_SECRET="change-me-local-only"

# --- Mail (ADR-0011) ------------------------------------------------------
# MAIL_DRIVER: "log" sends nothing and logs the subject; "smtp" actually sends.
# The default is "log" on purpose — a half-configured environment should send
# no mail rather than send it from an unintended identity.
MAIL_DRIVER="smtp"

# Locally: mailpit, which accepts anything and wants no credentials.
# Inbox at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
# true only for port 465 (implicit TLS). Port 587 is STARTTLS and must be false;
# setting it true there hangs until the socket times out.
SMTP_SECURE=false
# Leave both unset for mailpit — an empty user makes nodemailer attempt AUTH
# and get refused. Set them for a real relay.
# SMTP_USER=""
# SMTP_PASS=""
# Most relays reject or rewrite a From that is not the authenticated account,
# so in deployment this equals SMTP_USER. The display name is added from BRAND.
MAIL_FROM="no-reply@localhost"

# --- Observability (optional in dev) --------------------------------------
SENTRY_DSN=""
LOG_LEVEL="debug"

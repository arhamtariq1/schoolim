# Copy to `.env` at the workspace root and fill in.
#
# One file, at the root, for every package (see `loadEnv` in apps/api). A
# package-local `.env` still wins if one exists, but the root file is the
# default — three copies of the same credentials is how the API ends up dialling
# a database that no command-line tool is using.
#
# NOTHING IN HERE IS A REAL CREDENTIAL. `.env` itself is gitignored; this file
# is not, so never paste a working secret into it.

# --- Database ---------------------------------------------------------------
# The RLS-enforcing application role. All tenant traffic. Must be NOBYPASSRLS.
DATABASE_URL=postgresql://ilm_app:password@localhost:5432/ilm
# The owner role. Migrations, platform routes and tenant resolution only.
DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5432/ilm

# --- Auth -------------------------------------------------------------------
# 32 bytes minimum. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Leave unset. Host-only session cookies are what stop one school's browser
# ever transmitting another's token.
# COOKIE_DOMAIN=

# --- HTTP -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
APP_DOMAIN=localhost
# Must match the portal's PORTAL_TENANT_MODE. See docs/SINGLE-HOST-MODE.md.
PORTAL_TENANT_MODE=subdomain

# --- Mail -------------------------------------------------------------------
# `log` sends nothing and says so, which is the right default: failing to send
# is recoverable, sending as the wrong identity is not.
MAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS on 465. Port 587 starts in the clear — leave false.
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=no-reply@localhost

# --- Storage (ADR-0013) -----------------------------------------------------
# `database` keeps uploaded files in Postgres, behind row-level security. It is
# a real driver, not a stub: local development and CI need no account.
#
# Set to `cloudinary` to put PUBLIC assets on the CDN. Private assets stay in
# the database whatever this says — see `StorageRouter`.
#
# Naming `cloudinary` without the three credentials below fails at boot, on
# purpose: a deployment that cannot reach its storage should refuse to start
# rather than accept a term's traffic and break on the first upload.
STORAGE_DRIVER=database

# From the Cloudinary console (Dashboard → Product Environment Credentials).
# The cloud name is not a secret — it appears in every asset URL. The API secret
# is: anyone holding it can write to and delete from the account.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# The top-level folder every asset sits under. ONE PER ENVIRONMENT: public ids
# are deterministic, so staging and production sharing a prefix means a staging
# upload silently overwrites the production file with the same id.
CLOUDINARY_FOLDER=local

# Sits on the path of a person pressing Save, so keep it short.
CLOUDINARY_TIMEOUT_MS=15000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

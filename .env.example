# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- Database -------------------------------------------------------------
# DATABASE_URL      : the APPLICATION role. No BYPASSRLS. All tenant traffic.
# DATABASE_ADMIN_URL: the OWNER role. Migrations and platform/super-admin only.
# Local (docker compose up):
DATABASE_URL="postgresql://ilm_app:ilm_local_dev@localhost:5433/ilm?schema=public"
DATABASE_ADMIN_URL="postgresql://ilm:ilm_local_dev@localhost:5433/ilm?schema=public"

# Supabase (deployed, Phase 0-1). Use the SESSION pooler (5432) for migrations
# and the TRANSACTION pooler (6543) for runtime. set_config(..., true) is
# transaction-local, so RLS works correctly through the transaction pooler.
# DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DATABASE_ADMIN_URL="postgresql://...pooler.supabase.com:5432/postgres"

# --- Redis (BullMQ, Phase 2+) ---------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-32-chars-minimum-for-local-dev-only"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN="localhost"

# --- API ------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
INTERNAL_JOB_SECRET="change-me-local-only"

# --- Mail (mailpit locally, http://localhost:8025) ------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Ilm <no-reply@localhost>"

# --- Observability (optional in dev) --------------------------------------
SENTRY_DSN=""
LOG_LEVEL="debug"
